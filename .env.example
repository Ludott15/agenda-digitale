# Agenda Digitale - configurazione. Compila i valori, poi lancia: npm run setup

# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server: Project Settings → API → service_role. Non esporre mai al browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard Supabase → Connect → Connection string → Session pooler (URI),
# con la password del database al posto di [YOUR-PASSWORD].
SUPABASE_DB_URL=

# Amministratore dell'app (creato o promosso dallo script di setup).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Peppe Moschetto"

# Notifiche push (web-push). Coppia di chiavi: npx web-push generate-vapid-keys
# La pubblica è esposta al browser, la privata solo al server. Se mancano, restano le notifiche in-app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contatto per i servizi push: mailto: oppure https:
VAPID_SUBJECT=

# Promemoria giornalieri: Vercel invia "Authorization: Bearer $CRON_SECRET" a /api/cron/reminders.
CRON_SECRET=

# Opzionale: personal access token da supabase.com → Account → Access Tokens.
# Serve a disattivare automaticamente le registrazioni pubbliche.
SUPABASE_ACCESS_TOKEN=
